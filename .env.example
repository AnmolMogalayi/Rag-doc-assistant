# ============================================================================
# RAG-Based Technical Documentation Assistant — environment configuration
# Copy to `.env` and fill in the key for your chosen LLM provider.
# Embeddings default to a LOCAL model, so NO key is needed just to run retrieval.
# ============================================================================

# ----- App -----
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=*

# ----- LLM provider (pick ONE) -----
# llm_provider one of: openai | anthropic | groq | google_genai | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Optional cheaper model for grading/rewriting (defaults to LLM_MODEL):
# FAST_LLM_MODEL=gpt-4o-mini

# Provide the key matching LLM_PROVIDER:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=        # LLM_PROVIDER=anthropic, LLM_MODEL=claude-3-5-haiku-latest
# GROQ_API_KEY=             # LLM_PROVIDER=groq, LLM_MODEL=llama-3.3-70b-versatile
# GOOGLE_API_KEY=           # LLM_PROVIDER=google_genai, LLM_MODEL=gemini-1.5-flash
# OLLAMA_BASE_URL=http://localhost:11434   # LLM_PROVIDER=ollama, LLM_MODEL=llama3.1

# ----- Embeddings -----
# embedding_provider: huggingface (local, default, free) | openai
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----- Chunking -----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MARKDOWN_HEADER_SPLIT=true

# ----- Retrieval -----
TOP_K=5
RETRIEVAL_FETCH_K=20
USE_HYBRID_SEARCH=true
USE_RERANKER=true

# ----- Graph control -----
MAX_RETRIES=2
MAX_GENERATION_ATTEMPTS=1
RECURSION_LIMIT=25
ENABLE_SELF_CHECK=true

# ----- Web search fallback (bonus) -----
ENABLE_WEB_SEARCH=false
# TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=3

# ----- Conversation memory (bonus) -----
ENABLE_MEMORY=true

# ----- Observability (optional) -----
ENABLE_LANGSMITH=false
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-doc-assistant
